# 카카오 지도 + 장소 검색 (Kakao Developers → 앱 키 → JavaScript 키)
# 플랫폼 → Web → 사이트 도메인에 https://ansan-bite.vercel.app, http://localhost:5173 등록 필요
# 비워두면 무료 지도(OpenStreetMap)로 동작
VITE_KAKAO_JS_KEY=

# DB 저장(동기화): Upstash Redis (Vercel → Storage → Upstash 연결하면 KV_* 는 자동으로 들어감)
# 목록은 누구나 보고, 바꾸기는 가입(닉네임 + 각자 비밀번호)한 사람만.
# APP_PASSCODE: (선택) 예전 공유 비밀번호. 예전에 쓰던 닉네임으로 가입할 때 한 번 확인 → 남이 그 닉네임을 못 가져감
# APP_PASSCODE=
# ADMIN_NICKS: (선택) 쉼표로 구분. 다른 사람이 추가한 식당도 지울 수 있는 닉네임 (보통은 직접 추가한 사람만 지울 수 있음)
# ADMIN_NICKS=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
